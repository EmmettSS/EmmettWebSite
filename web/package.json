{
  "name": "@emmett/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsx scripts/render-assets.ts && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content:check": "tsx scripts/content-check.ts",
    "jalali:check": "tsx scripts/check-jalali.ts",
    "tool:contract": "tsx scripts/tool-contract.ts",
    "tool:contract:live": "tsx scripts/tool-contract.ts --live",
    "budget": "tsx scripts/bundle-budget.ts",
    "a11y": "playwright test",
    "seo:render": "tsx scripts/render-public-html.ts",
    "seo:check": "tsx scripts/seo-check.ts",
    "assets:render": "tsx scripts/render-assets.ts",
    "api:types": "openapi-typescript ../api/schema.yml -o src/lib/api-types.ts",
    "corpus:export": "tsx scripts/export-corpus.ts",
    "corpus:check": "tsx scripts/export-corpus.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
