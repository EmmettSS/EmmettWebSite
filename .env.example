# Copy to an untracked local env file; production values live in cPanel environment config.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production; set only after B1 domain is verified.
PUBLIC_SITE_URL=
BACKUP_DIR=/private/emmett-backups
DB_ENGINE=sqlite
# Omit DB_NAME locally to use api/db.sqlite3; set a database name for MySQL/MariaDB.
DB_USER=emmett
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.invalid
# Production: configure SMTP backend, host, credentials and a verified sender in cPanel.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
# ---- F-06 passive scanner (weights are editable without a deploy) ----
SCANNER_WEIGHT_HEADERS=0.30
SCANNER_WEIGHT_TLS=0.25
SCANNER_WEIGHT_DNS=0.15
SCANNER_WEIGHT_COOKIES=0.10
SCANNER_WEIGHT_CONTENT=0.10
SCANNER_WEIGHT_LEAK=0.10
# ---- F-08 assistant (ADR-007). B7 open → keep 'null': BM25 ships, no key anywhere. ----
ASSISTANT_LLM_PROVIDER=null
ASSISTANT_LLM_RELAY_URL=
ASSISTANT_LLM_RELAY_TOKEN=
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=
ASSISTANT_EMBED_MODEL=
ASSISTANT_DAILY_COST_CAP_USD=0
ASSISTANT_LLM_TIMEOUT=20
# Tunables for retrieval: the threshold is applied before any LLM call.
ASSISTANT_SIMILARITY_THRESHOLD=0.35
ASSISTANT_BM25_MIN_SCORE=0.6
ASSISTANT_BM25_MIN_COVERAGE=0.5
# Optional: point the corpus builder at a docs checkout.
# ASSISTANT_CORPUS_DIR=/home/account/APP/docs
# STATIC_BRIDGE_DIR=/home/account/public_html
VITE_API_BASE_URL=/api/v1
