{
  "name": "emmett-platform",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @emmett/web dev",
    "build": "pnpm --filter @emmett/web build && pnpm --filter @emmett/web seo:render && pnpm --filter @emmett/web seo:check",
    "lint": "pnpm --filter @emmett/web lint",
    "typecheck": "pnpm --filter @emmett/web typecheck",
    "test": "pnpm --filter @emmett/web test",
    "content:check": "pnpm --filter @emmett/web content:check",
    "budget": "pnpm --filter @emmett/web budget",
    "a11y": "pnpm --filter @emmett/web a11y"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
