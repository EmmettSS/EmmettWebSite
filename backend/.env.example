# کپی این فایل به .env و مقادیر واقعی را جایگزین کنید.
# هرگز فایل .env واقعی را commit نکنید (قانون ۵).

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database (فقط در production.py استفاده می‌شود؛ dev.py همیشه SQLite است)
# ---------------------------------------------------------------------------
MYSQL_DATABASE=emmett_production
MYSQL_USER=emmett_user
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ---------------------------------------------------------------------------
# Cache (ADR-0006) — گزینه‌ها: locmem | filebased
# ---------------------------------------------------------------------------
CACHE_BACKEND=filebased
CACHE_LOCATION=/tmp/emmett-django-cache

# ---------------------------------------------------------------------------
# CORS (فقط توسعهٔ محلی؛ در prod همان‌-مبدأ از طریق reverse proxy)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Security (مقادیر واقعی سخت‌گیرانه در فاز امنیت نهایی می‌شوند)
# ---------------------------------------------------------------------------
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# ---------------------------------------------------------------------------
# Rate limiting (ADR-0006 — DRF ScopedRateThrottle، نه django-ratelimit)
# ---------------------------------------------------------------------------
THROTTLE_RATE_ANON=100/hour
THROTTLE_RATE_USER=1000/hour
THROTTLE_RATE_CONTACT=5/hour
THROTTLE_RATE_AI=20/hour
THROTTLE_RATE_AUTH=10/hour
THROTTLE_RATE_NEWSLETTER=3/day

# ---------------------------------------------------------------------------
# Media uploads (ADR-0005) — سقف حجم به مگابایت
# ---------------------------------------------------------------------------
MEDIA_MAX_IMAGE_SIZE_MB=5
MEDIA_MAX_DOCUMENT_SIZE_MB=10

# ---------------------------------------------------------------------------
# Notifications (ADR در DISCOVERY.md — Kavenegar به‌عنوان کانال اصلی)
# ---------------------------------------------------------------------------
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# شمارهٔ تیم داخلی برای دریافت پیامک درخواست تماس جدید (خالی = غیرفعال)
LEADS_NOTIFICATION_PHONE=
# ایمیل تیم داخلی برای دریافت رسید فرم تماس (خالی = غیرفعال)
LEADS_NOTIFICATION_EMAIL=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@emmett.example

# AI (ADR-0026) — never commit a provider key or paste it into chat.
AI_ENABLED=false
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=15
AI_CACHE_TTL_SECONDS=86400
AI_AUDIT_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# SEO (فاز ۷ — ADR-0031): تنها منبع حقیقت دامنهٔ عمومی سایت
# ---------------------------------------------------------------------------
# دامنهٔ نهایی هنوز قطعی نشده؛ در production مقدار واقعی (مثلاً https://emmett.ir)
# را بگذارید. در حالت ``manage.py check --deploy`` خالی‌بودن/پیش‌فرض‌بودن آن خطا
# است (emmett_admin.W007). همین مقدار پایهٔ canonical/hreflang/OG/sitemap است.
PUBLIC_SITE_URL=http://localhost:3000
# کد تأیید Google Search Console فقط در ادمین (Site settings → SEO) ذخیره می‌شود؛
# در حالت ``check --deploy`` نبودنش هشدار W010 است.
# مدت کش payloadهای SEO (ثانیه)
SEO_SITEMAP_CACHE_SECONDS=900
SEO_REDIRECTS_CACHE_SECONDS=300
# شمارش بازدید ریدایرکت‌ها (در سایت‌های پرترافیک می‌توان خاموش کرد)
SEO_COUNT_REDIRECT_HITS=True

# ---------------------------------------------------------------------------
# Security headers (فاز ۷ — ADR-0033)
# ---------------------------------------------------------------------------
DJANGO_CSP_ENABLED=True
# برای تست بدون شکستن: فقط گزارش‌گیری در مرورگر، بدون مسدودسازی
DJANGO_CSP_REPORT_ONLY=False
DJANGO_CSP_REPORT_URI=
# دامنه‌های تصویر مجاز در CSP (خالی = فقط self)
DJANGO_CSP_IMG_SRC=
# frame-ancestors: در dev پیش‌فرض 'self' است (پیش‌نمایش iframe کار کند)؛
# در production پیش‌فرض 'none' می‌شود. برای دامنهٔ خودی: DJANGO_FRAME_ANCESTORS=https://emmett.ir
DJANGO_FRAME_ANCESTORS=
DJANGO_REFERRER_POLICY=strict-origin-when-cross-origin
DJANGO_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()

# ---------------------------------------------------------------------------
# Login lockout (فاز ۷ — ADR-0033): محافظت brute-force ورود ادمین/API
# ---------------------------------------------------------------------------
LOGIN_LOCKOUT_ENABLED=True
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_DURATION_SECONDS=900

# ---------------------------------------------------------------------------
# Admin 2FA (فاز ۷ — ADR-0033) — در production اجبار روشن است (W009)
# ---------------------------------------------------------------------------
ADMIN_2FA_REQUIRED=False
ADMIN_2FA_ISSUER=Emmett
ADMIN_2FA_RECOVERY_CODE_COUNT=8

# ---------------------------------------------------------------------------
# Backup (فاز ۷ — ADR-0033): دستور ``manage.py backup_db``
# ---------------------------------------------------------------------------
# مسیر نوشتنی روی هاست اشتراکی (W011/W012). پیش‌فرض: <BASE_DIR>/backups
BACKUP_DIR=
BACKUP_RETENTION=7
BACKUP_INCLUDE_MEDIA=True
