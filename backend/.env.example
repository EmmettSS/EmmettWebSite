# کپی این فایل به .env و مقادیر واقعی را جایگزین کنید.
# هرگز فایل .env واقعی را commit نکنید (قانون ۵ — توسط scripts/check_secrets.py بررسی می‌شود).

# ---------------------------------------------------------------------------
# ۱) هستهٔ جنگو (Django Core)
# ---------------------------------------------------------------------------
# در محیط توسعه: config.settings.dev | در سرور پروداکشن cPanel: config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.dev
# در پروداکشن باید یک رشتهٔ تصادفی حداقل ۵۰ کاراکتری با آنتروپی بالا باشد:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-secret
DJANGO_DEBUG=True
# در پروداکشن دامنه‌های واقعی را وارد کنید: emmett.ir,www.emmett.ir,127.0.0.1,localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# ۲) دیتابیس MySQL 8 (فقط در production.py استفاده می‌شود؛ dev.py همیشه SQLite است)
# ---------------------------------------------------------------------------
MYSQL_DATABASE=emmett_production
MYSQL_USER=emmett_user
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# ۳) مسیرهای فایل‌های استاتیک و مدیا (ADR-0005، ADR-0035، ADR-0036)
# ---------------------------------------------------------------------------
# اگر خالی باشند به صورت خودکار روی <BASE_DIR>/staticfiles و <BASE_DIR>/media قرار می‌گیرند.
# در هاست cPanel می‌توانید آن‌ها را به /home/<cpanel_user>/public_html/static و media تنظیم کنید.
DJANGO_STATIC_ROOT=
DJANGO_MEDIA_ROOT=
MEDIA_MAX_IMAGE_SIZE_MB=5
MEDIA_MAX_DOCUMENT_SIZE_MB=10

# ---------------------------------------------------------------------------
# ۴) کش بدون Redis (ADR-0006) — گزینه‌ها: locmem | filebased
# ---------------------------------------------------------------------------
CACHE_BACKEND=filebased
CACHE_LOCATION=.cache/django-cache
ADMIN_DASHBOARD_CACHE_SECONDS=120

# ---------------------------------------------------------------------------
# ۵) CORS، CSRF، کوکی‌ها و HTTPS/HSTS (فاز ۷ و ۹ — ADR-0033، ADR-0036)
# ---------------------------------------------------------------------------
# در توسعهٔ محلی: http://localhost:3000 | در پروداکشن دامنهٔ واحد: خالی بگذارید
CORS_ALLOWED_ORIGINS=http://localhost:3000
# در پروداکشن: https://emmett.ir,https://www.emmett.ir
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# ---------------------------------------------------------------------------
# ۶) محدودیت نرخ درخواست (Rate Limiting — ADR-0006)
# ---------------------------------------------------------------------------
THROTTLE_RATE_ANON=100/hour
THROTTLE_RATE_USER=1000/hour
THROTTLE_RATE_CONTACT=5/hour
THROTTLE_RATE_AI=20/hour
THROTTLE_RATE_AUTH=10/hour
THROTTLE_RATE_NEWSLETTER=3/day

# ---------------------------------------------------------------------------
# ۷) اعلان‌های پیامکی کاوه‌نگار و ایمیل SMTP (ADR-0024، ADR-0036)
# ---------------------------------------------------------------------------
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# شمارهٔ موبایل تیم فروش برای دریافت پیامک سرنخ جدید (خالی = غیرفعال)
LEADS_NOTIFICATION_PHONE=
# ایمیل تیم فروش برای دریافت رسید فرم تماس (خالی = غیرفعال)
LEADS_NOTIFICATION_EMAIL=
# در توسعه: django.core.mail.backends.console.EmailBackend
# در پروداکشن: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@emmett.example
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# ---------------------------------------------------------------------------
# ۸) درگاه مرکزی هوش مصنوعی (ADR-0026 — قوانین ۱۲، ۱۳، ۱۴)
# ---------------------------------------------------------------------------
AI_ENABLED=false
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=15
AI_CACHE_TTL_SECONDS=86400
AI_AUDIT_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# ۹) سئو و دامنهٔ عمومی (فاز ۷ — ADR-0031)
# ---------------------------------------------------------------------------
# تنها منبع حقیقت برای ساخت canonical، hreflang، sitemap.xml، OG و فیدهای RSS.
# در پروداکشن حتماً روی دامنهٔ HTTPS واقعی (مثلاً https://emmett.ir) تنظیم شود (W007).
PUBLIC_SITE_URL=http://localhost:3000
SEO_SITEMAP_CACHE_SECONDS=900
SEO_REDIRECTS_CACHE_SECONDS=300
SEO_COUNT_REDIRECT_HITS=True

# ---------------------------------------------------------------------------
# ۱۰) هدرهای امنیتی CSP، قفل ورود و 2FA ادمین (فاز ۷ — ADR-0033)
# ---------------------------------------------------------------------------
DJANGO_CSP_ENABLED=True
DJANGO_CSP_REPORT_ONLY=False
DJANGO_CSP_REPORT_URI=
DJANGO_CSP_IMG_SRC=
# در پروداکشن مقدار 'none' توصیه می‌شود
DJANGO_FRAME_ANCESTORS=
DJANGO_REFERRER_POLICY=strict-origin-when-cross-origin
DJANGO_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()

LOGIN_LOCKOUT_ENABLED=True
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_DURATION_SECONDS=900

# در پروداکشن روی True قرار دهید (اجبار TOTP 2FA برای همهٔ کارکنان پنل ادمین — W009)
ADMIN_2FA_REQUIRED=False
ADMIN_2FA_ISSUER=Emmett
ADMIN_2FA_RECOVERY_CODE_COUNT=8

# ---------------------------------------------------------------------------
# ۱۱) پشتیبان‌گیری خودکار (فاز ۷ — ADR-0033: دستور manage.py backup_db)
# ---------------------------------------------------------------------------
BACKUP_DIR=
BACKUP_RETENTION=7
BACKUP_INCLUDE_MEDIA=True
