"""نمونه فایل ورودی Phusion Passenger برای Setup Python App در cPanel (ADR-0035).

نحوهٔ استفاده روی هاست cPanel:
    cp backend/deploy/passenger_wsgi.py.example backend/passenger_wsgi.py

در صفحهٔ Setup Python App در cPanel:
- Application root: /home/<cpanel_user>/EmmettWebSite/backend
- Application startup file: passenger_wsgi.py
- Application Entry point: application
"""

import os
import sys
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent
if str(BASE_DIR) not in sys.path:
    sys.path.insert(0, str(BASE_DIR))

os.environ.setdefault("DJANGO_SETTINGS_MODULE", "config.settings.production")

from config.wsgi import application  # noqa: E402, F401
