# قواعد تکمیلی امنیتی برای public_html روی cPanel (ADR-0035، ADR-0036).
#
# Passenger routing is owned by the cPanel Setup Python/Node.js Apps and its generated
# .htaccess rules: Node.js serves /; Django is mounted at /backend. This file does not
# configure Passenger routing. Merge these rules with the cPanel-managed file; NEVER
# replace that file wholesale with this example.
#
# Public path map:
# - /api/v1/* -> Next.js Route Handler -> Django at /backend/api/v1/*
# - /backend/admin/* and /backend/i18n/* -> Django Passenger app
# - /static/* and /media/* -> public_html symlinks (when configured)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ۱) اجبار HTTPS در تمام درخواست‌ها (قانون ۱۶)
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ۲) سرو مستقیم فایل‌های استاتیک و مدیا در صورت وجود فیزیکی روی دیسک
    RewriteCond %{REQUEST_URI} ^/(static|media)/ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
</IfModule>

# ۳) فشرده‌سازی پاسخ‌های متنی
# چرا لازم است؟ `next start` فقط پاسخ‌های داینامیک را gzip می‌کند و فایل‌های
# `/_next/static/*.js` را **فشرده‌نشده** می‌فرستد (اندازه‌گیری‌شده: ۲۷۵KB به‌جای
# ~۹۰KB در صفحهٔ اصلی). Apache جلوی Node می‌تواند این شکاف را پر کند؛ بدون این
# بلوک، هر بازدیدکننده چند صد کیلوبایت اضافه دانلود می‌کند.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
        application/javascript application/json application/xml image/svg+xml
</IfModule>

# ۴) تزریق امن IP واقعی کلاینت، هدرهای امنیتی پایه و کش دارایی‌های استاتیک Apache
<IfModule mod_headers.c>
    # بازنویسی X-Forwarded-For با همتای TCP واقعی در لبهٔ Apache 2.4 تا هر هدر جعلی
    # ارسالی توسط کلاینت پاک شود و زنجیرهٔ Passenger Node (Next.js) -> Django دقیقاً IP
    # واقعی کاربر را ببیند (هم‌راستا با DJANGO_NUM_PROXIES=1 در .env).
    # توجه ۱: از نحو Apache 2.4 («expr=%{REMOTE_ADDR}») استفاده کنید، نه «%{REMOTE_ADDR}e»
    # که متغیر محیطی است و بدون SetEnv مقدار «(null)» تولید می‌کند.
    # توجه ۲: اگر سایت پشت CDN (کلادفلر/آروان) قرار گرفت و mod_remoteip روی هاست فعال نبود،
    # دستور «set» زیر را به «append» تغییر دهید و در .env مقدار DJANGO_NUM_PROXIES=2 بگذارید.
    # راستی‌آزمایی روی هاست واقعی: پس از ورود به /backend/admin/، مسیر GET /api/v1/health/proxy/ را باز کنید.
    RequestHeader set X-Forwarded-For "expr=%{REMOTE_ADDR}"
    RequestHeader set X-Real-IP "expr=%{REMOTE_ADDR}"
    RequestHeader set X-Forwarded-Proto "https"

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"

    <FilesMatch "\.(woff2|woff|css|js|png|jpg|jpeg|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
</IfModule>

# ۵) غیرفعال‌سازی کامل فهرست دایرکتوری‌ها و مسدودسازی دسترسی به فایل‌های نقطه (.env, .git)
Options -Indexes
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
